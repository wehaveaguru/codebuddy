{
  "name": "codebuddy",
  "displayName": "codebuddy",
  "description": "vscode extension that helps you through your coding process",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codebuddy.openchat",
        "title": "CodeBuddy",
        "icon": "${sparkle}"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "codebuddy.openchat",
          "group": "1_modification"
        }
      ],
      "commandPalette": [
        {
          "command": "codebuddy.openchat"
        }
      ]
    }
  },
  "configuration": {
    "title": "CodeBuddy",
    "properties": {
      "codebuddy.apiKey": {
        "type": "string",
        "default": "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",
        "description": "Groq API Key from console.groq.com/keys"
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.3",
    "@types/vscode": "^1.107.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "dependencies": {
    "groq-sdk": "^0.37.0",
    "openai": "^4.52.0"
  }
}
